[Unit]
Description=Halloween motion-triggered scare
After=pipewire.service wireplumber.service

[Service]
WorkingDirectory=%h/scare
Environment=SCARE_BT_SPEAKER=30:22:21:04:EC:80
Environment=SCARE_AMBIENT_VOLUME=0.12
ExecStart=/usr/bin/python3 %h/scare/scare.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
